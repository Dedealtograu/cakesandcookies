generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  cep       String
  admin     Boolean  @default(false)
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Decimal  @default(0)
  image       String
  category    String
  createdAt   DateTime @default(now())
}
